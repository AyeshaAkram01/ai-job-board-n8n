      "parameters": {
        "jsCode": "const existingRows = $('Get Existing Rows').all();\nconst existingUrls = existingRows.map(item => item.json.URL);\n\nconst newJobs = $input.all();\n\nconst filteredJobs = newJobs.filter(job => !existingUrls.includes(job.json.url));\n\nreturn filteredJobs;"
      },
