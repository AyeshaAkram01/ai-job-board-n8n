    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "try {\n  const aiResult = JSON.parse($input.item.json.text);\n  const originalJob = $('Dedup Filter').itemMatching($itemIndex).json;\n\n  // Reject responses where the AI clearly didn't have real content to work with\n  const badPhrases = ['job listing is incomplete', 'no details', 'analyze the provided', 'extract structured information'];\n  const summaryLower = (aiResult.summary || '').toLowerCase();\n  const isBadResponse = badPhrases.some(phrase => summaryLower.includes(phrase));\n\n  if (isBadResponse || !originalJob.title) {\n    return null; // skip this item entirely\n  }\n\n  return {\n    json: {\n      title: originalJob.title,\n      company: originalJob.company,\n      location: originalJob.location,\n      job_type: originalJob.job_type,\n      url: originalJob.url,\n      seniority: aiResult.seniority,\n      tech_stack: aiResult.tech_stack,\n      summary: aiResult.summary\n    }\n  };\n} catch (error) {\n  return null; // skip on any parse error too\n}"
      },
