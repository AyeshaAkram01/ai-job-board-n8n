        "text": "=",
        "messages": {
          "messageValues": [
            {
              "type": "HumanMessagePromptTemplate",
              "message": "=You are a job listing analyzer. Read the job listing below and extract structured information.  Job Title: {{$json.title}} Company: {{$json.company}} Job Type: {{$json.job_type}} Description: {{$json.description}}  Analyze this job and respond with ONLY a valid JSON object in this exact format, no extra text, no markdown code blocks:  {   \"seniority\": \"Entry-Level\" or \"Mid-Level\" or \"Senior\" or \"Not Specified\",   \"tech_stack\": \"a short comma-separated list of key technologies mentioned, or 'None' if not a tech role\",   \"summary\": \"one sentence, under 20 words, summarizing what this role actually involves\" }"
            }
          ]
        },
        "batching": {}
