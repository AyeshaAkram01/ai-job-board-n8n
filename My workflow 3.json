    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Get the current item's description\nlet description = $input.item.json.description;\n\n// Strip all HTML tags\nlet cleanText = description.replace(/<[^>]*>/g, ' ');\n\n// Collapse multiple spaces/newlines into single spaces\ncleanText = cleanText.replace(/\\s+/g, ' ').trim();\n\n// Limit to first 500 characters to keep it concise for the AI\ncleanText = cleanText.substring(0, 500);\n\n// Return the item with the cleaned description\nreturn {\n  json: {\n    ...$input.item.json,\n    description: cleanText\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
